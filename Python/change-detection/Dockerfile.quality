FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-quality.txt .
RUN pip install --no-cache-dir -r requirements-quality.txt
COPY quality_engine.py quality_api.py quality_service.py .
USER 65534:65534
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/quality/ready',timeout=2).close()"]
CMD ["uvicorn", "quality_service:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
